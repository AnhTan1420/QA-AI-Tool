# ============================================================================
# .env.example — copy to .env.local (local) or set in Vercel → Settings →
# Environment Variables (production). Placeholders only; never commit real keys.
# ============================================================================

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only, never expose to the client

# ── AI provider (Gemini only) ───────────────────────────────────────────────
GOOGLE_GEMINI_API_KEY=your-gemini-api-key

# ── Model pool — every task resolves to:
#      [task-specific model] -> AI_MODEL_PRIMARY -> AI_MODEL_FALLBACK_1 -> AI_MODEL_FALLBACK_2
# Recommended: gemini-3.8-flash. Code is version-agnostic for gemini-3.x (thinkingLevel is sent to
# any model named gemini-3*; 2.x models never receive it).
AI_MODEL_PRIMARY=gemini-3.8-flash
AI_MODEL_FALLBACK_1=gemini-3.6-flash
AI_MODEL_FALLBACK_2=gemini-3.5-flash

# ── Per-task models (all optional) ──────────────────────────────────────────
AI_MODEL_GENERATION=gemini-3.7-flash
AI_MODEL_COVERAGE_REPAIR=gemini-3.7-flash       # defaults to AI_MODEL_GENERATION

# REVIEW and ENHANCE are INDEPENDENT. Set them separately in Vercel; they may
# intentionally point at different models. Neither inherits the other:
#   Review  chain: AI_MODEL_REVIEW  -> AI_MODEL_PRIMARY -> fallbacks
#   Enhance chain: AI_MODEL_ENHANCE -> AI_MODEL_PRIMARY -> fallbacks
AI_MODEL_REVIEW=gemini-3.7-flash
AI_MODEL_ENHANCE=gemini-3.7-flash

AI_MODEL_CLASSIFICATION=gemini-3.6-flash
AI_MODEL_DOCUMENT_EXTRACTION=gemini-3.7-flash   # must support multimodal input
AI_MODEL_PLAYWRIGHT_CODEGEN=gemini-3.7-flash
AI_MODEL_PLAYWRIGHT_HEAL=gemini-3.7-flash       # defaults to AI_MODEL_PLAYWRIGHT_CODEGEN
AI_MODEL_EMBEDDING=gemini-embedding-001

# ── Time budget & sizing (optional) ─────────────────────────────────────────
# Every route creates ONE execution budget from its `maxDuration` and passes it down,
# so retries/fallbacks/repair stop BEFORE Vercel kills the function (and partial work is returned).
AI_BUDGET_RESERVE_MS=15000            # held back for persistence + response (1000–60000)
AI_ASSUMED_OUTPUT_TPS=90              # assumed Gemini output tokens/sec; only sizes per-call timeouts
AI_GENERATION_MAX_OUTPUT_TOKENS=16384 # ceiling for ONE generation/repair call (4096–65536)
AI_GENERATION_REQUEST_TIMEOUT_MS=100000 # CEILING for one generation attempt (sized per batch below it)
# Optional operator cap on total cases spent on per-category minimums. UNSET by default: generation
# now splits categories into bounded batches instead of lowering the minimum per category.
# AI_GENERATION_CATEGORY_FLOOR_CAP=

# ── Output-token budgets (optional) ─────────────────────────────────────────
# Generate = large (built-in 16384) · Review = small · Enhance = moderate.
# Do not raise Review's budget to accommodate verbose output; shrink the prompt.
AI_REVIEW_MAX_OUTPUT_TOKENS=5120    # clamped to 512–8192. Keep >= 4700: Review's worst-case output (REVIEW_LIMITS) is ~2.5k tokens and must stay under 55% of this
AI_ENHANCE_MAX_OUTPUT_TOKENS=8192   # clamped to 1024–16384
# Acceptance of generated cases in code (services/ai/generation-acceptance.ts):
#   off      nothing
#   repair   (default) deterministic: derive priority from risk_ranking, fill/drop atom citations by evidence, drop duplicate scenarios; quality defects are WARNED, never rejected, no extra model calls
#   enforce  repair + reject cases failing min steps / vague wording / test-data lint, and regenerate the affected category ONCE (spends route time budget)
GENERATION_ACCEPTANCE=repair

# ── Resilience (optional) ───────────────────────────────────────────────────
GEMINI_REQUEST_TIMEOUT_MS=120000
GEMINI_MAX_RETRIES_PER_MODEL=2
GEMINI_BACKOFF_BASE_MS=1000
GEMINI_BACKOFF_MAX_MS=8000
# Rate limit (429): longest server "retry in Ns" hint to sleep through on the SAME model while a fallback
# exists (default 10000). Raise it when the primary is your only strong model; bounded by the route budget.
GEMINI_MAX_RATE_LIMIT_WAIT_MS=10000

# ── Generation / coverage repair (optional) ─────────────────────────────────
AI_MAX_COVERAGE_REPAIR_ROUNDS=4
AI_COVERAGE_REPAIR_BATCH_SIZE=35

# ── Misc (optional) ─────────────────────────────────────────────────────────
FIGMA_ACCESS_TOKEN=your-figma-personal-access-token
AUTOMATION_RUNTIME=serverless   # 'serverless' (Vercel default) or 'local'

# ── Cloudflare R2 (optional; unset falls back to Supabase Storage) ──────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=qa-automation-assets
